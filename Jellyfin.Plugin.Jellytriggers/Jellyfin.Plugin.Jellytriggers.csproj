<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.Jellytriggers</RootNamespace>
    <AssemblyVersion>0.1.0.11</AssemblyVersion>
    <FileVersion>0.1.0.11</FileVersion>
  </PropertyGroup>

  <!--
    Jellyfin packages MUST set ExcludeAssets=runtime, otherwise the plugin
    DLL ships duplicate copies of Jellyfin's own runtime assemblies and the
    plugin loader rejects it as "NotSupported".
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!--
      Newtonsoft.Json is used only for the File Transformation hand-off
      (its callback contract is JObject-shaped). ExcludeAssets=runtime
      means we use the copy Jellyfin already loads, not a duplicate.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Embed the admin config page and the web bundle so we can serve them from
    the running plugin without any filesystem lookup.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\jellytriggers.js" />
    <EmbeddedResource Include="Web\jellytriggers.css" />
  </ItemGroup>

</Project>
